{
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended",
    "google"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "require-jsdoc": "off",
    "padded-blocks": "off",
    "no-useless-catch": "off",
    "max-len": "off",
    "object-curly-spacing": [
      "error",
      "always"
    ],
    "arrow-parens": [
      "error",
      "as-needed"
    ],
    "camelcase": "off",
    "new-cap": "off",
    "valid-jsdoc": "off"
  }
}
